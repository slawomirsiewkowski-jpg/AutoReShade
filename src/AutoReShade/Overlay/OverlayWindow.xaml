<Window x:Class="AutoReShade.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoReShade overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        Width="300" Height="300">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!-- The clock, and below it the map-name notification so it never covers the clock -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image x:Name="ClockImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Border x:Name="Placeholder"
                Visibility="Collapsed"
                CornerRadius="12"
                Background="#B0141012"
                BorderBrush="#FFB21C24"
                BorderThickness="2">
            <TextBlock Text="Clock overlay"
                       Foreground="#FFECE6E1"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <Border x:Name="AdjustFrame"
                Visibility="Collapsed"
                BorderBrush="#FFE53935"
                BorderThickness="3"
                Background="#22FFFFFF"
                Cursor="SizeAll">
            <Border VerticalAlignment="Bottom"
                    Margin="8"
                    Padding="10,6"
                    CornerRadius="6"
                    Background="#E0141012">
                <TextBlock x:Name="AdjustHint"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </Border>

        <Border x:Name="Toast"
                Grid.Row="1"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Padding="12,5"
                CornerRadius="8"
                Background="#E0141012"
                BorderBrush="#FFB21C24"
                BorderThickness="1">
            <TextBlock x:Name="ToastText"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
