<Window x:Class="AutoReShade.Views.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose map - AutoReShade"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Text="Type to search, then press Enter."
                   Margin="0,0,0,8"
                   Opacity="0.8" />
        <TextBox x:Name="SearchBox"
                 DockPanel.Dock="Top"
                 Margin="0,0,0,10"
                 TextChanged="OnSearchChanged"
                 PreviewKeyDown="OnSearchKeyDown" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Show this map" IsDefault="True" Click="OnChoose" MinWidth="120" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ListBox x:Name="MapList"
                 MouseDoubleClick="OnChoose"
                 KeyDown="OnListKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Map.DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RealmName}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
